# SentinelVoice Environment Configuration
PROJECT_NAME="SentinelVoice"
ENV="development"
DEBUG=True

# Database (Default: SQLite async, optional: postgresql+asyncpg://user:pass@localhost:5432/sentinel_db)
DATABASE_URL="sqlite+aiosqlite:///./sentinel_voice.db"

# Fraud & Biometric Guardrails
FRAUD_RISK_THRESHOLD=15.0
MIN_BIOMETRIC_CONFIDENCE=85.0
MIN_LIVENESS_SCORE=75.0

# Financial Action Deterministic Policy Limits
MAX_WAIVER_AMOUNT=50.0
MAX_WAIVER_DAYS_INTERVAL=90
MAX_CREDIT_LIMIT_INCREASE_PCT=25.0
MAX_ALLOWED_RISK_TIER_FOR_ACTIONS=2

# AI Models (Optional OpenAI API Key for external LLM reasoning)
OPENAI_API_KEY=""
WHISPER_API_KEY=""
MODEL_NAME="gpt-4o"
